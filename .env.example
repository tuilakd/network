# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DOCKER & DATABASE
# ==========================================

# Tên database mặc định khớp với Spring Boot
DB_NAME=networkdb

# Mật khẩu tài khoản root MySQL (khớp với mặc định trong application.properties)
DB_ROOT_PASSWORD=admin

# Cổng MySQL expose ra máy host
DB_PORT=3306

# Secret JWT và mật khẩu admin hệ thống
JWT_SECRET=dev-only-jwt-secret-change-me-before-deploying-1234567890
ADMIN_PASSWORD=admin123
